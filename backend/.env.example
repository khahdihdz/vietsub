# CHỈ dùng ở backend. KHÔNG bao giờ đưa các biến này vào frontend/bundle/localStorage.
VILAO_API_KEY=
VILAO_BASE_URL=https://api.vilao.ai/v1
VILAO_MODEL=deepseek/deepseek-v4-pro

# Số lần retry khi gọi AI thất bại
AI_MAX_RETRIES=3
# Độ trễ cơ bản (ms) cho exponential backoff
AI_RETRY_BASE_DELAY_MS=800

# Số subtitle context trước/sau mặc định
TRANSLATION_CONTEXT_BEFORE=5
TRANSLATION_CONTEXT_AFTER=5

# Kích thước chunk khi dịch video dài + overlap giữ ngữ cảnh giữa các chunk
TRANSLATION_CHUNK_SIZE=100
TRANSLATION_CHUNK_OVERLAP=5
